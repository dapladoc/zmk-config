#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0
#define NUM     1
#define NAV     2
#define CFG     3

/ {
    behaviors {
        ht: hold_tap {
            label = "hold_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            require-prior-idle-ms = <80>;
            quick-tap-ms = <50>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        st: shift_tap {
            label = "shift_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <120>;
            bindings = <&kp>, <&kp>;
        };
    };

    // Unicode entry via the Linux/IBus "Ctrl+Shift+U <hex> Enter" method,
    // for Russian letters with no good phonetic English-layout equivalent.
    // Needs an IBus-style unicode input method to be active in the OS to
    // work -- verify once flashed, this doesn't work in every app/DE.
    macros {
        ru_shch: ru_shch {
            // щ U+0449
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHIFT>
                , <&macro_tap &kp U>
                , <&macro_release &kp LCTRL &kp LSHIFT>
                , <&macro_tap &kp N0 &kp N4 &kp N4 &kp N9>
                , <&macro_tap &kp ENTER>
                ;
        };

        ru_yo: ru_yo {
            // ё U+0451
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHIFT>
                , <&macro_tap &kp U>
                , <&macro_release &kp LCTRL &kp LSHIFT>
                , <&macro_tap &kp N0 &kp N4 &kp N5 &kp N1>
                , <&macro_tap &kp ENTER>
                ;
        };

        ru_hard_sign: ru_hard_sign {
            // ъ U+044A
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHIFT>
                , <&macro_tap &kp U>
                , <&macro_release &kp LCTRL &kp LSHIFT>
                , <&macro_tap &kp N0 &kp N4 &kp N4 &kp A>
                , <&macro_tap &kp ENTER>
                ;
        };

        ru_kha: ru_kha {
            // х U+0445
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHIFT>
                , <&macro_tap &kp U>
                , <&macro_release &kp LCTRL &kp LSHIFT>
                , <&macro_tap &kp N0 &kp N4 &kp N4 &kp N5>
                , <&macro_tap &kp ENTER>
                ;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        both_layer {
            if-layers = <NUM NAV>;
            then-layer = <CFG>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <40>;
            key-positions = <1 2>;
            bindings = <&kp ESC>;
            layers = <DEFAULT>;
            require-prior-idle-ms = <250>;
        };

        combo_del {
            timeout-ms = <40>;
            key-positions = <8 9>;
            bindings = <&kp DEL>;
            require-prior-idle-ms = <250>;
        };

        combo_bksp {
            timeout-ms = <40>;
            key-positions = <16 17>;
            bindings = <&kp BSPC>;
        };

        combo_lwin {
            timeout-ms = <30>;
            key-positions = <23 24>;
            bindings = <&kp LGUI>;
            layers = <DEFAULT NUM NAV>;
            require-prior-idle-ms = <500>;
        };

        combo_rwin {
            timeout-ms = <30>;
            key-positions = <25 26>;
            bindings = <&kp LGUI>;
            require-prior-idle-ms = <500>;
        };

        combo_lshift {
            timeout-ms = <30>;
            key-positions = <20 21>;
            bindings = <&kp LSHIFT>;
            layers = <DEFAULT NUM NAV>;
        };

        combo_rshift {
            timeout-ms = <30>;
            key-positions = <28 29>;
            bindings = <&kp RSHIFT>;
        };

        combo_capsword {
            timeout-ms = <40>;
            key-positions = <20 29>;
            bindings = <&caps_word>;
        };

        // Extra Russian letters, typing layer only. Positions are free
        // pairs not used by any other combo above.
        combo_ru_shch {
            timeout-ms = <40>;
            key-positions = <6 7>;
            bindings = <&ru_shch>;
            layers = <DEFAULT>;
            require-prior-idle-ms = <250>;
        };

        combo_ru_yo {
            timeout-ms = <40>;
            key-positions = <3 4>;
            bindings = <&ru_yo>;
            layers = <DEFAULT>;
            require-prior-idle-ms = <250>;
        };

        combo_ru_hard_sign {
            timeout-ms = <40>;
            key-positions = <12 13>;
            bindings = <&ru_hard_sign>;
            layers = <DEFAULT>;
            require-prior-idle-ms = <250>;
        };

        combo_ru_kha {
            timeout-ms = <40>;
            key-positions = <14 15>;
            bindings = <&ru_kha>;
            layers = <DEFAULT>;
            require-prior-idle-ms = <250>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q  &kp W       &kp E         &kp R        &kp T       &kp Y        &kp U        &kp I         &kp O       &kp P
&kp A  &ht LALT S  &ht LSHIFT D  &ht LCTRL F  &ht LGUI G  &ht RGUI H   &ht RCTRL J  &ht RSHIFT K  &ht RALT L  &kp SQT
&kp Z  &kp X       &kp C         &kp V        &kp B       &kp N        &kp M        &kp COMMA     &kp DOT     &kp FSLH
                               &lt NUM TAB  &kp SPACE               &kp BSPC     &lt NAV ENTER
            >;
        };

        num_layer {
            display-name = "Numbers";
            bindings = <
&kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR
&kp N1    &kp N2  &kp N3    &kp N4    &kp N5     &kp N6     &kp N7    &kp N8     &kp N9    &kp N0
&kp F1    &kp F2  &kp F3    &kp F4    &kp F5     &kp F6     &kp F7    &kp F8     &kp F9    &kp F10
                            &trans    &kp ENTER             &kp ESC   &trans
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&trans  &trans  &trans  &trans  &trans   &trans     &trans     &trans     &trans    &trans
&trans  &trans  &trans  &trans  &trans   &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT &trans
&trans  &trans  &trans  &trans  &trans   &kp HOME   &kp PG_DN  &kp PG_UP  &kp END   &trans
                         &trans  &trans              &trans     &trans
            >;
        };

        both_layer {
            display-name = "Config";
            bindings = <
&sys_reset   &trans  &trans  &studio_unlock  &bt BT_SEL 0  &trans  &trans  &trans  &trans  &sys_reset
&bootloader  &trans  &trans  &trans          &bt BT_SEL 1  &trans  &trans  &trans  &trans  &bootloader
&trans       &trans  &trans  &bt BT_CLR      &bt BT_SEL 2  &trans  &trans  &trans  &trans  &trans
                             &trans          &trans                &trans  &trans
            >;
        };
    };
};
